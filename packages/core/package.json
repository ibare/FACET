{
  "name": "@ffacet/core",
  "version": "0.5.0",
  "type": "module",
  "description": "FACET 4-layer 러너 시스템 코어 — runtime / views / types. 알고리즘 시각화 재생 런타임(runFacet/loadFacet)과 registry 단일 출처.",
  "license": "MIT",
  "author": "Mintae Kim <ibare77@gmail.com>",
  "homepage": "https://github.com/ibare/FACET/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibare/FACET.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ibare/FACET/issues"
  },
  "keywords": [
    "facet",
    "algorithm-visualization",
    "interactive-visualization",
    "runtime"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "import": "./dist/runtime.js"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.0",
    "rollup": "^4.28.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-esbuild": "^6.1.1",
    "typescript": "^5.6.3"
  }
}
