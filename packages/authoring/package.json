{
  "name": "@ffacet/authoring",
  "version": "0.3.0",
  "type": "module",
  "description": "facet 개념(concept) authoring 메타데이터. 호스트 LLM 파이프라인이 글에 넣을 시각화를 고르고(definition 임베딩), 고른 시각화의 내용을 writer 에게 전달(briefing)하는 데 쓰는 단일 출처.",
  "license": "MIT",
  "author": "Mintae Kim <ibare77@gmail.com>",
  "homepage": "https://github.com/ibare/FACET/tree/main/packages/authoring#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibare/FACET.git",
    "directory": "packages/authoring"
  },
  "bugs": {
    "url": "https://github.com/ibare/FACET/issues"
  },
  "keywords": [
    "facet",
    "authoring",
    "concept",
    "embedding",
    "llm"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
