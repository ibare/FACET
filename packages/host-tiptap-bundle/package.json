{
  "name": "@ffacet/host-tiptap-bundle",
  "version": "0.4.0",
  "type": "module",
  "description": "Self-contained ESM bundle of @ffacet/host-tiptap + 전체 facet 카탈로그 + transpilers + view-code. methii 등 외부 호스트 앱에서 단일 의존으로 소비.",
  "license": "MIT",
  "author": "Mintae Kim <ibare77@gmail.com>",
  "homepage": "https://github.com/ibare/FACET/tree/main/packages/host-tiptap-bundle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibare/FACET.git",
    "directory": "packages/host-tiptap-bundle"
  },
  "bugs": {
    "url": "https://github.com/ibare/FACET/issues"
  },
  "keywords": [
    "facet",
    "tiptap",
    "prosemirror",
    "algorithm-visualization",
    "interactive-visualization",
    "nodeview"
  ],
  "main": "./dist/host-tiptap-bundle.js",
  "types": "./dist/host-tiptap-bundle.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host-tiptap-bundle.d.ts",
      "import": "./dist/host-tiptap-bundle.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && rollup -c rollup.config.mjs",
    "build:analyze": "VISUALIZE=1 rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@ffacet/core": "workspace:^",
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0"
  },
  "devDependencies": {
    "@ffacet/bootstrap": "workspace:*",
    "@ffacet/core": "workspace:*",
    "@ffacet/host-tiptap": "workspace:*",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@tiptap/core": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "rollup": "^4.28.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-esbuild": "^6.1.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "^5.6.3"
  }
}
