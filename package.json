{
  "name": "facet",
  "version": "0.0.0",
  "private": true,
  "description": "Framework for Abstraction and Concept Exploration through Translation",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --filter @ffacet/playground dev",
    "build": "pnpm --filter @ffacet/playground build",
    "build:bundle": "pnpm --filter @ffacet/host-tiptap-bundle build",
    "build:bundle:analyze": "pnpm --filter @ffacet/host-tiptap-bundle build:analyze",
    "preview": "pnpm --filter @ffacet/playground preview",
    "catalog:gen": "tsx scripts/gen-facet-catalog.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r run typecheck",
    "messages:gen": "tsx scripts/gen-messages.mts",
    "screen:gen": "tsx scripts/gen-screen-labels.mts",
    "concept:audit": "tsx scripts/concept-audit.mts",
    "i18n:audit": "tsx scripts/i18n-audit.mts"
  },
  "devDependencies": {
    "@ffacet/algorithm-bubble-sort": "workspace:*",
    "@ffacet/bootstrap": "workspace:*",
    "@ffacet/core": "workspace:*",
    "@ffacet/host-tiptap": "workspace:*",
    "@ffacet/ir-interpreter": "workspace:*",
    "@ffacet/transpiler-cpp": "workspace:*",
    "@ffacet/transpiler-csharp": "workspace:*",
    "@ffacet/transpiler-java": "workspace:*",
    "@ffacet/transpiler-javascript": "workspace:*",
    "@ffacet/transpiler-python": "workspace:*",
    "@ffacet/transpiler-typescript": "workspace:*",
    "@types/node": "^22.9.0",
    "happy-dom": "^20.9.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
